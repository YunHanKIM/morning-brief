# 자동 브리핑 API(POST /api/cron/brief) 인증용 비밀값. GitHub Actions secret에도 같은 값을 넣는다.
# 긴 무작위 문자열을 쓴다 (예: openssl rand -hex 32). 비어 있으면 API는 500으로 닫힌다.
CRON_SECRET=

# 자동 브리핑의 날씨 도시. 주요 도시 이름(서울, 부산, 인천, 대구, 대전, 광주, 울산, 제주)
# 또는 도시 JSON({"name":"도쿄","region":"도쿄 도","country":"일본","latitude":35.6895,"longitude":139.6917,"timezone":"Asia/Tokyo"}).
# 비어 있으면 서울. 잘못된 값이면 날씨만 오류로 표시된다.
BRIEF_CITY=
