# 자동 브리핑 API(POST /api/cron/brief) 인증용 비밀값. GitHub Actions secret에도 같은 값을 넣는다.
# 긴 무작위 문자열을 쓴다 (예: openssl rand -hex 32). 비어 있으면 API는 500으로 닫힌다.
CRON_SECRET=

# 자동 브리핑의 날씨 도시. 주요 도시 이름(서울, 부산, 인천, 대구, 대전, 광주, 울산, 제주)
# 또는 도시 JSON({"name":"도쿄","region":"도쿄 도","country":"일본","latitude":35.6895,"longitude":139.6917,"timezone":"Asia/Tokyo"}).
# 비어 있으면 서울. 잘못된 값이면 날씨만 오류로 표시된다.
BRIEF_CITY=

# Telegram 알림. 봇 토큰은 @BotFather에서, chat id는 봇에게 메시지를 보낸 뒤 getUpdates 등으로 확인.
# 토큰은 123456789:ABC... 형식, chat id는 숫자(그룹은 음수) 또는 @채널이름. 비어 있거나 형식이 틀리면 전송은 failed로 처리된다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 스냅샷 저장소(Upstash Redis REST). Upstash 대시보드의 REST URL/Token. https 주소만 허용.
# Vercel 연동으로 만들면 KV_REST_API_URL / KV_REST_API_TOKEN 이름으로 들어오며, 그 이름도 읽는다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 개발용: memory로 두면 메모리 저장소를 쓴다(서버를 다시 켜면 사라짐). 배포 환경에서는 비워 둔다.
SNAPSHOT_STORE=
